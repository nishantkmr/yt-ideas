{
  "name": "kids-trivia-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remotion-powered production system for a kids GK and trivia channel.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "video": "node scripts/make-video.mjs",
    "video:preview": "node scripts/make-video.mjs --preview",
    "video:check": "node scripts/make-video.mjs --dry-run",
    "render:content": "node scripts/render-content.mjs",
    "still": "node scripts/render-still.mjs",
    "validate:content": "node scripts/validate.mjs",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "prepare:content": "node scripts/prepare-content.mjs",
    "generate:voiceover": "node scripts/generate-voiceover.mjs",
    "generate:voiceover:force": "node scripts/generate-voiceover.mjs --force",
    "generate:voiceover:check": "node scripts/generate-voiceover.mjs --all --dry-run --strict-cache",
    "generate:sfx": "node scripts/generate-sfx.mjs",
    "generate:music": "node scripts/generate-music.mjs",
    "setup:voiceover": "python -m pip install -r requirements-tts.txt --target .tools/edge-tts",
    "generate:voiceover:edge": "python scripts/generate-neural-voiceover.py",
    "setup:kokoro": "python -m pip install -r requirements-kokoro.txt --target .tools/kokoro-onnx && python scripts/download-kokoro-model.py",
    "sample:kokoro": "python scripts/generate-kokoro-sample.py",
    "sample:sarvam": "python scripts/generate-sarvam-samples.py",
    "typecheck": "tsc --noEmit",
    "sync:media": "node scripts/sync-media.mjs --all",
    "predev": "node scripts/sync-media.mjs --all",
    "prebuild": "node scripts/sync-media.mjs --all"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.520",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.520"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2"
  }
}
